{
  "name": "json-format-example",
  "description": "Example agent: postToolUse hook that validates and pretty-formats JSON files after they are written",
  "tools": ["read", "write", "shell"],
  "hooks": {
    "postToolUse": [
      {
        "matcher": "write",
        "command": "bash ./hooks/format-json-on-write.sh"
      }
    ]
  }
}
